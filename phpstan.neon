parameters:
	level: 8

	paths:
		- src

	excludePaths:
		- src/compatibility.php
		- src/compatibility-intf.php

	fileExtensions:
		- php
		- phtml

	ignoreErrors:
		-   # generated Latte code: attribute interpolation emits a dead `=== null` check for values that are never null
			identifier: identical.alwaysFalse
			count: 2
			path: src/Bridges/SecurityTracy/dist/tab.phtml

		-   # runtime guard of the IIdentity::getRoles() contract, which PHP does not enforce: an identity may still return Role objects
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Security/User.php

		-   # nette/di 3.2 makes a service lazy through a property, the installed dev version through methods
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Bridges/SecurityDI/SecurityExtension.php

		-   # the same: the property of nette/di 3.2 is private in the installed dev version
			identifier: property.private
			count: 1
			path: src/Bridges/SecurityDI/SecurityExtension.php
